{
  "name": "ayurtech-average-api",
  "version": "1.0.0",
  "description": "REST API that returns the running average of all numbers POSTed to /average",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "client": "node client/cli.js",
    "prepare": "husky install"
  },
  "keywords": ["rest", "api", "average", "express"],
  "author": "Ayurtech Candidate",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "supertest": "^7.0.0"
  },
  "lint-staged": {
    "*.js": ["eslint --fix", "jest --bail --findRelatedTests"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}